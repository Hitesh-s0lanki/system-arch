# Docker Compose publishes the gateway on this loopback port.
PROXY_PORT=8088
# Optional JSON configuration to mount when launching Compose.
# RATE_LIMIT_CONFIG=./configs/proxy.json
RATE_LIMIT_UPSTREAM=http://backend:8080
RATE_LIMIT_NAMESPACE=demo
# Used by compose.redis.yaml; leave the private service address for the example.
REDIS_URL=redis://redis:6379/0
# Optional static credentials. Generate real tokens for your deployment.
RATE_LIMIT_CREDENTIALS=[]

# Optional: enables /metrics. Use a random secret in production.
RATE_LIMIT_METRICS_TOKEN=
# Optional Sentinel authentication (data-node credentials come from REDIS_URL).
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=
# Optional published image for `docker compose up --no-build`.
# RATE_LIMIT_IMAGE=ghcr.io/hitesh-s0lanki/system-arch/distributed-rate-limiter:latest
