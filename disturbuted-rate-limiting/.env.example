# Docker Compose publishes the gateway on this loopback port.
PROXY_PORT=8088
RATE_LIMIT_UPSTREAM=http://backend:8080
RATE_LIMIT_NAMESPACE=demo
# Used by compose.redis.yaml; leave the private service address for the example.
REDIS_URL=redis://redis:6379/0
# Optional static credentials. Generate real tokens for your deployment.
RATE_LIMIT_CREDENTIALS=[]
