# ==============================================================================
# Environment Configuration for Video Streaming Service (Java Spring Boot)
# ==============================================================================

# Server Port
PORT=8080

# Storage directory for uploads and transcoded HLS chunks (.m3u8 & .ts)
VIDEO_UPLOAD_DIR=./uploads

# File upload limit
MAX_FILE_SIZE=500MB
MAX_REQUEST_SIZE=500MB

# FFmpeg binary path (if installed globally via Homebrew / apt, keep "ffmpeg")
# macOS Homebrew Apple Silicon: /opt/homebrew/bin/ffmpeg
# macOS Homebrew Intel: /usr/local/bin/ffmpeg
# Linux: /usr/bin/ffmpeg
FFMPEG_PATH=ffmpeg

# Segment duration in seconds (Netflix typically uses 4 seconds)
HLS_TIME=4

# CORS allowed origins (e.g. * or http://localhost:3000)
CORS_ALLOWED_ORIGINS=*
